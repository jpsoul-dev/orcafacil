# -----------------------------------------------------------------------------
# ORCA FÁCIL - CONFIGURAÇÕES DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env.local e preencha com suas chaves.
# -----------------------------------------------------------------------------

# URL do seu projeto do Supabase (ex: https://foqwusedfevhozrvwsudbw.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Chave pública anônima do Supabase para o frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Chave privada de serviço (Service Role) para operações críticas de admin no backend
# ATENÇÃO: NUNCA exponha esta chave no frontend (NÃO use o prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# INTEGRAÇÃO COM STRIPE (PAGAMENTOS & ASSINATURAS)
# -----------------------------------------------------------------------------

# Chave secreta da API do Stripe (ex: sk_test_...)
STRIPE_SECRET_KEY=your-stripe-secret-key

# ID do preço do produto Stripe configurado para a assinatura do SaaS (ex: price_...)
STRIPE_PRICE_ID=your-stripe-price-id

# Segredo de assinatura do webhook do Stripe para validação de eventos (ex: whsec_...)
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# -----------------------------------------------------------------------------

# URL base do frontend da aplicação (usado para callbacks e links de redirecionamento)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
